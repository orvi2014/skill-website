# Copy this file to .env.local and fill in your real SMTP credentials.
# Restart `npm run dev` (or redeploy) after changing these.

# Your mail server connection details.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Optional overrides — default to SMTP_USER / support@skill.ventures if omitted.
# CONTACT_FROM_EMAIL=no-reply@skill.ventures
# CONTACT_TO_EMAIL=support@skill.ventures
