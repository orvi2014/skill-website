# Copy to deploy.env and fill in. deploy.env is gitignored.
# Then run: npm run deploy   or   ./scripts/deploy.sh

# Required — server IP or hostname (change this when the server moves)
DEPLOY_HOST=203.76.149.101

# SSH login
DEPLOY_USER=skill
DEPLOY_SSH_PORT=22

# Optional path to a private key (leave empty to use your default ssh-agent / ~/.ssh/id_*)
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# App location on the server (tilde is fine)
DEPLOY_PATH=~/skill-website

# Next.js listen port (PM2 / reverse proxy should match this)
DEPLOY_PORT=3001

# PM2 process name
DEPLOY_PM2_NAME=skill-website

# Set to 0 to skip remote npm install + build (rsync + restart only)
DEPLOY_BUILD=1

# Set to 0 to skip curl health checks after restart
DEPLOY_VERIFY=1
